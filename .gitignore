__pycache__/
*.py[cod]
.venv/
venv/
.env
.pytest_cache/
.ruff_cache/

# Data artefacts — never commit bulk data to git.
# Raw responses go to object storage; built Parquet is published as a release.
data/raw/
data/staging/
data/core/
data/marts/
data/gov_raw/
data/gov/
data/findings/
*.parquet
*.jsonl
*.jsonl.gz

# ...but site/data/ IS committed. It is the published deliverable — ~24 MB of
# aggregates, not raw data — and it cannot be rebuilt in CI, because data.gov.ro
# refuses connections from GitHub and Azure IP ranges (see docs/sources.md). A locally
# generated bundle is the only way Pages can serve anything. The negation has to come
# after `*.parquet`, and the directory has to be unignored before its contents.
!site/data/
!site/data/**

# ...except the raw line items, which are an ingest staging area. They are ~110 bytes a
# row against 47 for the slim archive, and they are rewritten on every run. `achizitii
# publish` distils them into site/data/preturi/, which IS committed and append-only.
site/data/items/

# State IS committed (it is small and is the resume ledger)
!state/
