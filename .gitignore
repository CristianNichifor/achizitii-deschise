__pycache__/
node_modules/
test-results/
playwright-report/
*.py[cod]
.venv/
venv/
.env
.pytest_cache/
.ruff_cache/

# Data artefacts — never commit bulk data to git.
# Raw responses go to object storage; built Parquet is published as a release.
data/raw/
data/staging/
data/core/
data/marts/
data/gov_raw/
data/gov/
data/findings/
data/ruti_raw/
data/ruti/
data/firme/
*.parquet
*.jsonl
*.jsonl.gz

# ...but site/data/ IS committed. It is the published deliverable — ~24 MB of
# aggregates, not raw data — and it cannot be rebuilt in CI, because data.gov.ro
# refuses connections from GitHub and Azure IP ranges (see docs/sources.md). A locally
# generated bundle is the only way Pages can serve anything. The negation has to come
# after `*.parquet`, and the directory has to be unignored before its contents.
!site/data/
!site/data/**

# ...except the raw line items, which are an ingest staging area. They are ~110 bytes a
# row against 47 for the slim archive, and they are rewritten on every run. `achizitii
# publish` distils them into site/data/preturi/, which IS committed and append-only.
site/data/items/
# Consolidated monthly copies are an upload artefact, not a source of truth —
# the daily files under site/data/preturi/ are.
site/data/preturi-lunar/

# State IS committed (it is small and is the resume ledger)
!state/

# The published bundle. Derived: every `achizitii publish` rebuilds it whole, and git keeps
# each rebuild forever — three rollups had accumulated 271 MB of a 302 MB pack. It ships as a
# `bundle-*` release asset instead (scripts/release_bundle.sh), fetched by pages.yml and
# tests.yml (scripts/fetch_bundle.sh). See docs/storage.md.
#
# site/data/preturi/ is the exception and stays tracked: collected daily prices, written once
# and never rewritten, and the only copy that exists — unit prices cannot be reconstructed
# retroactively because the bulk exports carry no quantities.
site/data/*
!site/data/preturi/
